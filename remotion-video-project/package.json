{
  "name": "remotion-three-video-skill",
  "version": "1.0.0",
  "private": true,
  "description": "Configuration-driven Remotion template for polished Three.js videos.",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still VideoTemplate out/frame-300.png --frame=300 --scale=0.25 --gl=angle",
    "build": "remotion render VideoTemplate out/video.mp4 --codec=h264 --pixel-format=yuv420p --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.459",
    "@remotion/three": "4.0.459",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.459",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.171.0",
    "typescript": "^5.9.3"
  }
}
